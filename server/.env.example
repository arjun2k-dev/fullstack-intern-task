# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (the Vite dev server by default)
CLIENT_URL=https://fullstack-intern-task-z1w4.vercel.app/templates

# ---- Auth ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/template_store
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/template_store?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/template_store
